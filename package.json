{
  "name": "storystudio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-studio.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:studio": "node scripts/dev-studio.mjs",
    "export:server": "node scripts/export-server.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:camera-browser": "node scripts/check-camera-browser.mjs",
    "test:camera-export": "node scripts/check-camera-export.mjs",
    "test:production": "node scripts/check-camera-production.mjs",
    "test:browser": "node scripts/check-studio-browser.mjs",
    "test:export-service": "node --test tests/export-service.test.mjs",
    "test:export-ui": "node scripts/check-export-ui.mjs",
    "test:export": "node scripts/check-master-export.mjs",
    "test:export-quality": "node scripts/check-export-quality.mjs",
    "normalize:layers": "python3 scripts/normalize-layers.py",
    "render:frames": "node scripts/render-frames.mjs",
    "lab:basic": "node 'Legacy Code/Extras/camera-lab/render-camera-lab-basic.mjs'",
    "lab:basic-encode": "node 'Legacy Code/Extras/camera-lab/export-camera-lab-basic.mjs'",
    "export:video": "node scripts/export-video.mjs",
    "test:animation": "node --test tests/animation.test.mjs",
    "test:camera-moves-browser": "node scripts/check-camera-moves-browser.mjs",
    "test:camera-virtual-browser": "node scripts/check-camera-virtual-browser.mjs",
    "test:camera-advanced-browser": "node scripts/check-camera-advanced-browser.mjs",
    "test:parallax-browser": "node scripts/check-parallax-browser.mjs",
    "test:timeline-browser": "node scripts/check-timeline-browser.mjs",
    "test:playback-browser": "node scripts/check-playback-browser.mjs",
    "test:animation-browser": "node scripts/check-animation-browser.mjs",
    "test:animation-export": "node scripts/check-animation-export.mjs",
    "test:animation-export-ui": "node scripts/check-animation-export-ui.mjs",
    "test:real-project": "node scripts/check-real-project-export.mjs",
    "test:parallax-environmental-browser": "node scripts/check-parallax-environmental-browser.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/source-serif-4": "5.3.0",
    "pixi.js": "^8.22.0"
  },
  "devDependencies": {
    "playwright": "^1.58.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
